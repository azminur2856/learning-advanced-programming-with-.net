
@{
    ViewBag.Title = "EnrollmentConfirmation";
}

<h2>EnrollmentConfirmation</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<p>Thank you for submitting your enrollment request. The system will process your application.</p>